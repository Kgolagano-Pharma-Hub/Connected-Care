                    <execution>
                        <id>cm-system-libs-list</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>execute</goal>
                        </goals>
                        <configuration>
                            <scripts>
                                <script>
                                    def buildDir = new File(project.build.directory)
                                    def relativePath = "${project.build.finalName}/WEB-INF/lib/systemlibs.list.raw/"
                                    File source = new File(buildDir, relativePath)
                                    def list = []
                                    println "processing libs"
                                    source.eachLine { String line ->
                                    def matcher = line =~ /\s+[^:]+:[^:]+:[^:]+:[^:]+:[^:]+:([^:]+)/
                                    if(matcher.matches()){
                                    list.add new File(matcher[0][1]).getName()
                                    }
                                    }
                                    source.delete()
                                    def buildDir2 = new File(project.build.directory)
                                    def relativePath2 = "${project.build.finalName}/WEB-INF/lib/systemlibs.list/"
                                    File file = new File(buildDir2, relativePath2);
                                    list.sort()
                                    list.each { line ->
                                    file.append line
                                    file.append '\n'
                                    }
                                </script>
                            </scripts>
                        </configuration>
