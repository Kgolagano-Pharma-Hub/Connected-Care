<?xml version="1.0" encoding="UTF-8"?>
<project name="CMDBuildUI" default="build">

    <!-- Ensure Node and npm exist -->
    <target name="check-node">
        <exec executable="node" failonerror="true">
            <arg value="--version"/>
        </exec>
        <exec executable="npm" failonerror="true">
            <arg value="--version"/>
        </exec>
    </target>

    <!-- Install npm dependencies -->
    <target name="npm-install" depends="check-node">
        <echo message="Installing npm dependencies..." />
        <exec executable="npm" failonerror="true">
            <arg value="install"/>
        </exec>
    </target>

    <!-- Build the project (calls npm run build) -->
    <target name="npm-build" depends="npm-install">
        <echo message="Building UI with npm..." />
        <exec executable="npm" failonerror="true">
            <arg value="run"/>
            <arg value="build"/>
        </exec>
    </target>

    <!-- Copy locales or any static assets post-build -->
    <target name="-after-build" depends="npm-build">
        <echo message="Copying locales..." />
        <mkdir dir="${basedir}/dist/app/locales" />
        <copy todir="${basedir}/dist/app/locales/" failonerror="false" overwrite="true" quiet="true">
            <fileset dir="${basedir}/app/locales/" includes="**"/>
        </copy>
    </target>

    <!-- Default build target -->
    <target name="build" depends="-after-build">
        <echo message="Build complete. Output is in dist/ or build/ depending on your package.json settings." />
    </target>

</project>
